# ==============================================================================
# Media Parser 环境变量配置文件示例 (请复制本文件为 .env 并在本地配置真实值)
# ==============================================================================

# 控制台会话签名密钥（可选）。留空时会自动生成并保存到 data 目录。
# 修改该值会使已有登录会话失效。
SECRET_KEY=''

# SQLite 数据库路径。本地运行和 Docker 部署的数据都保存在 data 目录。
DATABASE_PATH='data/media_parser.db'

# 使用 Nginx、Caddy 等反向代理时可设为 true；直接访问 8051 端口时保持 false。
TRUST_PROXY_HEADERS='false'

# ==============================================================================
# 平台账号与增强 Cookie 配置（全部为可选配置，绝大多数平台开箱即用无需任何配置）
# 提示：请仅在本地 `.env` 中填写真实 Cookie，切勿提交到代码仓库。
# Cookie 中可能含有 `$`，请使用单引号包裹完整值，避免被 Docker Compose 当作变量插值。
# ==============================================================================

# 1. 豆包无水印视频 (可选，用于解密获取 1080P 原始纯净无水印视频)
# 建议粘贴完整 Cookie；精简格式至少包含 `sessionid_ss=xxx`。
# 未配置时仍可解析公开无水印图片与带水印预览切片。
DOUBAO_COOKIE=''

# 2. 微信视频号高清流 (可选，通过腾讯元宝接口提取视频号原始流、高清图集及背景原声)
# 涉及个人账号登录凭证，建议使用闲置小号。精简格式至少包含 `hy_user=xxx; hy_token=yyy`。
# 未配置时仍可完全免登录获取视频号公开基础信息（标题/作者/封面）。
YUANBAO_COOKIE=''

# 3. 小红书防风控 / 高频解析 (可选，用于解决服务器机房 IP 匿名请求可能遭遇的 302 登录拦截)
# 精简格式至少包含 `a1=xxx; webId=yyy; web_session=zzz`。
# 日常情况下默认无需 Cookie 即可通过双 UA 自适应机制直接匿名解析。
XHS_COOKIE=''

# 4. 抖音放映厅长视频 (可选，仅在解析放映厅/影视长片/演唱会等强风控内容时需要)
# 精简格式至少包含 `s_v_web_id=verify_xxx; __ac_nonce=yyy`（仅为人机风控通行证，非账号登录态）。
# 日常 99%+ 的普通短视频、图文笔记、LivePhoto、原声音乐等完全免 Cookie 匿名直出。
DOUYIN_COOKIE=''

# 5. 哔哩哔哩高码率 (可选，用于提取 1080P 高码率/4K 及大会员专享番剧正片)
# 精简格式至少包含 `SESSDATA=xxx; bili_jct=yyy`。
# 未配置时仍可完全免登录获取 720P/1080P 官方基础音视频流。
BILIBILI_COOKIE=''

# 6. 拼多多多多视频 (可选，用于多多视频短视频信息流原画解析)
# 登录 mobile.yangkeduo.com 移动端后获取，精简格式至少包含 `PDDAccessToken=xxx`。
# 未配置时仍可免 Cookie 解析商品图集与评价秀实物素材。
PINDUODUO_COOKIE=''
