# ==============================================================================
# Media Parser 环境变量配置文件示例 (仅用于说明，请复制本文件为 .env 并在本地配置真实值)
# ==============================================================================

# 控制台会话签名密钥（可选）。留空时会自动生成并保存到 data 目录。
# 修改该值会使已有登录会话失效。
SECRET_KEY=''

# SQLite 数据库路径。本地运行和 Docker 部署的数据都保存在 data 目录。
DATABASE_PATH='data/media_parser.db'

# 使用 Nginx、Caddy 等反向代理时可设为 true；直接访问 8051 端口时保持 false。
TRUST_PROXY_HEADERS='false'

# 平台账号 Cookie 配置（提示：亦可直接在管理员后台「系统设置 - 平台凭据」直接热配置，免重启）
# 请仅在本地 `.env` 中填写真实 Cookie，切勿提交到仓库。
# Cookie 中可能含有 `$`，请使用单引号包裹完整值，避免被 Docker Compose 当作变量插值。

# 1. 小红书 Cookie (建议配置，防官方 302 登录风控拦截)
# 建议粘贴浏览器中获取的完整 Cookie；如需精简，至少应包含 `a1=字段值; webId=字段值; web_session=字段值`。
# 配置后可彻底避免因服务器 IP 匿名访问被重定向至 /login 登录页的问题。
XHS_COOKIE=''

# 2. 抖音 Cookie (可选；普通短视频与图文作品无需配置，开箱即用)
# 仅在解析放映厅/影视长剧 (/lvdetail/) 等强风控内容或需要个人账号权限时可选配置。
# 如需精简，至少应包含 `s_v_web_id=字段值; __ac_nonce=字段值`。
DOUYIN_COOKIE=''

# 3. 豆包解析需要已登录豆包账号的 Cookie (用于获取无水印原画视频)。
# 建议粘贴浏览器中获取的完整 Cookie；如需精简，至少应包含 `sessionid_ss=字段值`。
# 未配置或 Cookie 已过期时，仍可解析公开分享中的图片，但无法获取无水印视频。
DOUBAO_COOKIE=''

# 4. 视频号解析需要已登录腾讯元宝账号的 Cookie (涉及个人账号登录凭证，建议使用闲置小号)。
# 建议粘贴浏览器中获取的完整 Cookie；如需精简，至少应包含 `hy_user=字段值; hy_token=字段值`。
# 未配置或 Cookie 已过期时，仍可解析标题、作者等公开字段，但无法获取视频。
YUANBAO_COOKIE=''

# 5. 拼多多解析需要已登录拼多多账号的 Cookie (用于多多视频原画解析)。
# 建议粘贴移动端或浏览器中获取的完整 Cookie；如需精简，至少应包含 `PDDAccessToken=字段值`。
# 未配置或 Cookie 已过期时，仍可解析商品实物图与评价大图，但无法获取多多视频。
PINDUODUO_COOKIE=''

# 6. 哔哩哔哩 Cookie (可选；用于大会员 1080P 60FPS / 4K / 大会员专区番剧直链提取)。
# 建议粘贴浏览器中获取的完整 Cookie；如需精简，至少应包含 `SESSDATA=字段值; bili_jct=字段值`。
BILIBILI_COOKIE=''
