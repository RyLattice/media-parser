# ==========================================
# Media Parser 环境变量配置示例
# 复制本文件为 .env 并根据实际需求填入对应配置
# ==========================================

# ------------------------------------------
# 1. 基础运行与安全配置 (Core & Security)
# ------------------------------------------
# Flask 会话加密密钥（生产环境建议配置固定强随机字符串，留空则自动生成并持久化保存在 data/.secret_key）
SECRET_KEY=

# 数据库存储路径（默认指向 data/media_parser.db）
DATABASE_PATH=data/media_parser.db

# 是否信任反向代理（Nginx / Caddy 等）传递的 X-Forwarded-* 请求头（true / false）
TRUST_PROXY_HEADERS=false

# 站点对外访问的基础 URL（用于控制台与接口文档展示，可选，例如 https://api.yourdomain.com）
# API_BASE_URL=https://api.yourdomain.com

# 时区配置
TZ=Asia/Shanghai


# ------------------------------------------
# 2. 平台凭据与 Cookie 配置 (Platform Credentials)
# （大部分平台支持匿名免登录解析；当特定链接触发平台风控或需要鉴权时配置）
# ------------------------------------------

# 小红书 Cookie（支持 XHS_COOKIE 或 XIAOHONGSHU_COOKIE）
# 用于部分需要登录才能查看的小红书笔记
XHS_COOKIE=

# 快手 Cookie（支持 KUAISHOU_COOKIE 或 KS_COOKIE）
# 用于应对快手高频反爬拦截（result: 2 / ANTICRAWL_DEFAULT）
KUAISHOU_COOKIE=

# 拼多多 Cookie（支持 PINDUODUO_COOKIE 或 PDD_COOKIE）
# 用于拼多多短视频 dsp_detail 接口鉴权
PINDUODUO_COOKIE=

# 腾讯元宝 / 微信视频号 Cookie（支持 YUANBAO_COOKIE 或 WECHAT_CHANNELS_COOKIE）
# 视频号解析依赖腾讯元宝接口，需提供包含 user_id 和 session 信息的元宝 Cookie
YUANBAO_COOKIE=

# 抖音 Cookie（可选，支持 DOUYIN_COOKIE）
# 抖音默认已采用免 Argus 门禁的移动端 Feed 接口，通常无需配置
DOUYIN_COOKIE=

# 豆包 Cookie（支持 DOUBAO_COOKIE）
# 用于提取豆包 AI 深度会话中的多媒体内容
DOUBAO_COOKIE=

# 即梦 AI Cookie（支持 JIMENG_COOKIE）
# 用于即梦作品页鉴权
JIMENG_COOKIE=

# 微博 Cookie（支持 WEIBO_COOKIE）
# 用于微博长图文与特定视频流提取
WEIBO_COOKIE=


# ------------------------------------------
# 3. 抖音高级解析策略配置 (Douyin Advanced Tuning)
# ------------------------------------------
# 是否开启移动端 Feed 免签直连通道（1/true 为开启，0/false 为关闭，默认开启）
DOUYIN_ENABLE_MOBILE_FEED=1

# 抖音 Web API 重试最大尝试次数（默认 8 次）
DOUYIN_API_MAX_ATTEMPTS=8

# 抖音 Web API 重试基础退避延迟（秒，默认 0.2）
DOUYIN_RETRY_BASE_DELAY=0.2

# 抖音 Web API 重试单次最大退避延迟（秒，默认 0.8）
DOUYIN_RETRY_MAX_DELAY=0.8
